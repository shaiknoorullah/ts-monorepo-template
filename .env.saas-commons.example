# .env.saas-commons.example
#
# DEPRECATED — see docs/adrs/0006-yaml-config-with-c12.md.
# The canonical source is now config/saas-commons.yaml. Render with:
#   repo env render saas-commons --out docker/.env.saas-commons.rendered
#   docker compose -f docker/compose.saas-commons.yml \
#     --env-file docker/.env.saas-commons.rendered up -d
#
# This file is preserved only for backward-compat with existing tooling and
# will be removed once the YAML migration is verified end-to-end.
#
# AGENT-TODO(repo-cli): remove this file after the YAML migration is verified.
#
# Variables marked REQUIRED have no safe default; compose will fail-fast if unset.
# Variables marked default-changeme work for local dev but MUST be replaced before
# any non-local deployment.

# =========================================================================
# Lago — billing / metering
# =========================================================================
LAGO_FRONT_PORT=8101
LAGO_API_PORT=8102
LAGO_FRONT_URL=http://localhost:8101
LAGO_API_URL=http://localhost:8102
LAGO_POSTGRES_DB=lago
LAGO_POSTGRES_USER=lago
LAGO_POSTGRES_PASSWORD=changeme              # default-changeme

# REQUIRED — generate with `docker run --rm getlago/api:v1.18.0 rails secret`
LAGO_SECRET_KEY_BASE=

# REQUIRED — encryption keys. Generate any 32+ byte random strings:
#   openssl rand -hex 32
LAGO_ENCRYPTION_PRIMARY_KEY=
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=

# REQUIRED — base64-encoded RSA private key (PEM):
#   openssl genrsa 2048 | base64 -w0
LAGO_RSA_PRIVATE_KEY=

LAGO_DISABLE_SIGNUP=true

# =========================================================================
# Umami — web analytics
# =========================================================================
UMAMI_PORT=8103
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=changeme              # default-changeme

# REQUIRED — Umami JWT signing secret (>= 64 chars):
#   openssl rand -hex 32
UMAMI_APP_SECRET=

# =========================================================================
# Keycloak — identity / OIDC
# =========================================================================
KEYCLOAK_PORT=8104
KEYCLOAK_HOSTNAME=localhost                   # set to your public host in prod
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=changeme           # default-changeme
KEYCLOAK_ADMIN_USER=admin

# REQUIRED — bootstrap admin password, used only on first boot
KEYCLOAK_ADMIN_PASSWORD=

KEYCLOAK_LOG_LEVEL=INFO

# =========================================================================
# Unleash — feature flags
# =========================================================================
UNLEASH_PORT=4242
UNLEASH_POSTGRES_DB=unleash
UNLEASH_POSTGRES_USER=unleash
UNLEASH_POSTGRES_PASSWORD=changeme            # default-changeme
UNLEASH_LOG_LEVEL=info

# Optional — comma-separated tokens auto-created on first boot.
# Format: `<token-name>:<environment>.<random-secret>`
#   e.g. UNLEASH_INIT_CLIENT_API_TOKENS=ci:production.abc123
UNLEASH_INIT_ADMIN_API_TOKENS=
UNLEASH_INIT_CLIENT_API_TOKENS=
UNLEASH_INIT_FRONTEND_API_TOKENS=

# =========================================================================
# Meilisearch — search
# =========================================================================
MEILISEARCH_PORT=7700
MEILI_ENV=production                          # set to "development" for unkeyed local

# REQUIRED when MEILI_ENV=production — master key (>=16 bytes):
#   openssl rand -hex 32
MEILI_MASTER_KEY=

MEILI_LOG_LEVEL=INFO

# =========================================================================
# Uptime Kuma — status page / monitoring
# =========================================================================
UPTIME_KUMA_PORT=8105
# (no env vars — admin account is created on first UI visit)

# =========================================================================
# Chatwoot — customer support inbox
# =========================================================================
CHATWOOT_PORT=8106
CHATWOOT_FRONTEND_URL=http://localhost:8106
CHATWOOT_POSTGRES_DB=chatwoot_production
CHATWOOT_POSTGRES_USER=chatwoot
CHATWOOT_POSTGRES_PASSWORD=changeme           # default-changeme

# REQUIRED — generate with `docker run --rm chatwoot/chatwoot:v3.12.0 rails secret`
CHATWOOT_SECRET_KEY_BASE=

CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false
CHATWOOT_MAILER_SENDER_EMAIL=Chatwoot <noreply@example.com>
CHATWOOT_SMTP_DOMAIN=example.com
CHATWOOT_SMTP_ADDRESS=
CHATWOOT_SMTP_PORT=587
CHATWOOT_SMTP_USERNAME=
CHATWOOT_SMTP_PASSWORD=
