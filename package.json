{
  "name": "ts-monorepo-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade TypeScript microservice monorepo template — Nx + pnpm + changesets + Vitest + Vitepress + AGENTS.md",
  "homepage": "https://github.com/shaiknoorullah/ts-monorepo-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaiknoorullah/ts-monorepo-template.git"
  },
  "bugs": {
    "url": "https://github.com/shaiknoorullah/ts-monorepo-template/issues"
  },
  "license": "MIT",
  "author": "Shaik Noorullah",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.15.0"
  },
  "bin": {
    "repo": "./internal/cli/dist/cli.mjs"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test --base=origin/main",
    "test:coverage": "vitest run --coverage",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "type-check": "nx run-many -t type-check",
    "type-coverage": "type-coverage",
    "dev": "nx run-many -t dev --parallel=10",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dead": "knip",
    "deps": "syncpack lint",
    "deps:fix": "syncpack fix-mismatches && syncpack format",
    "sync": "syncpack fix-mismatches && syncpack format",
    "manypkg": "manypkg check",
    "attw": "nx run-many -t attw",
    "publint": "nx run-many -t publint",
    "doctor": "pnpm manypkg && pnpm deps && pnpm dead && pnpm type-check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm sync",
    "release": "pnpm build && changeset publish",
    "ci": "pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm dead && pnpm deps && pnpm manypkg",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@cyclonedx/cyclonedx-npm": "^4.0.0",
    "@manypkg/cli": "^0.25.1",
    "@microsoft/api-extractor": "^7.50.0",
    "@nx/eslint": "^21.0.0",
    "@nx/js": "^21.0.0",
    "@nx/vite": "^21.0.0",
    "@playwright/test": "^1.50.0",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/eslint-plugin": "^2.0.0",
    "@vitest/ui": "^4.0.0",
    "@arethetypeswrong/cli": "^0.18.0",
    "commitizen": "^4.3.0",
    "cspell": "^9.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.30.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-perfectionist": "^4.0.0",
    "eslint-plugin-promise": "^7.0.0",
    "eslint-plugin-security": "^3.0.0",
    "eslint-plugin-sonarjs": "^3.0.0",
    "eslint-plugin-unicorn": "^57.0.0",
    "knip": "^6.14.0",
    "lefthook": "^2.1.0",
    "lint-staged": "^16.0.0",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.20.0",
    "nx": "^21.0.0",
    "pkg-pr-new": "^0.0.50",
    "playwright": "^1.50.0",
    "prettier": "^3.5.0",
    "prettier-plugin-packagejson": "^2.5.0",
    "publint": "^0.3.0",
    "size-limit": "^11.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "syncpack": "^14.0.0",
    "tsd": "^0.32.0",
    "tsdown": "^0.6.0",
    "tsx": "^4.20.0",
    "type-coverage": "^2.29.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-coverage": "^4.0.0",
    "typedoc-plugin-markdown": "^4.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.30.0",
    "vitepress": "^2.0.0",
    "vitest": "^4.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "typeCoverage": {
    "atLeast": 95,
    "strict": true,
    "detail": true,
    "ignoreCatch": true,
    "cache": true
  }
}
