{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "docs/**",
    ".nx/**",
    "**/dist/**",
    "internal/templates/**",
    "**/node_modules/**"
  ],
  "ignoreDependencies": [
    "cz-conventional-changelog",
    "commitizen",
    "@stryker-mutator/*",
    "@size-limit/*",
    "size-limit",
    "playwright",
    "tsdown",
    "tsx",
    "typedoc",
    "typedoc-plugin-coverage",
    "typedoc-plugin-markdown",
    "unrun",
    "@types/react",
    "babel-preset-expo",
    "expo-system-ui",
    "expo-updates",
    "pino-pretty",
    "@resvg/resvg-wasm",
    "satori"
  ],
  "ignoreBinaries": ["pnpm", "node"],
  "ignoreWorkspaces": ["internal/templates/**"],
  "workspaces": {
    ".": {
      "entry": ["internal/scripts/**/*.{ts,mjs}"],
      "project": ["internal/scripts/**/*.{ts,mjs}"]
    },
    "apps/api-gateway": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/worker": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/cms": {
      "entry": ["src/app/**/*.{ts,tsx}", "payload.config.ts", "next.config.mjs"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/marketing": {
      "entry": ["src/pages/**/*.{astro,ts,tsx}", "astro.config.mjs"],
      "project": ["src/**/*.{ts,tsx,astro}"]
    },
    "apps/docs-public": {
      "entry": ["src/**/*.{astro,ts,tsx}", "astro.config.mjs"],
      "project": ["src/**/*.{ts,tsx,astro}"]
    },
    "apps/web-app": {
      "entry": ["app/**/*.{ts,tsx}", "App.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/mobile-customer": {
      "entry": ["app/**/*.{ts,tsx}", "App.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/mobile-admin": {
      "entry": ["app/**/*.{ts,tsx}", "App.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/*": {
      "entry": ["src/index.{ts,tsx}", "src/loaders/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "internal/cli": {
      "entry": ["src/cli.ts", "src/commands/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "internal/test-utils": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "internal/eslint-config": {
      "entry": ["index.mjs"],
      "project": ["**/*.{ts,mjs}"]
    },
    "internal/scripts": {
      "entry": ["**/*.{ts,mjs}"],
      "project": ["**/*.{ts,mjs}"]
    },
    "infra/cloudflare/workers/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
