strict_env
use devenv

if [ -f .profile ]; then
  export DEVENV_PROFILE="$(cat .profile)"
else
  export DEVENV_PROFILE="p-solo"
fi

# Inject declared secrets at enterShell time
if command -v secretspec >/dev/null 2>&1; then
  eval "$(secretspec export --profile "${SECRETSPEC_PROFILE:-default}" --shell)"
fi
