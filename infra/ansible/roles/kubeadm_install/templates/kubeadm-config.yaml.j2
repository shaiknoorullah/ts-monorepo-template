# Managed by Ansible role: kubeadm_install
apiVersion: kubeadm.k8s.io/v1beta3
kind: ClusterConfiguration
kubernetesVersion: v{{ kube_version }}
controlPlaneEndpoint: "{{ control_plane_endpoint }}"
networking:
  podSubnet: "{{ pod_cidr }}"
  serviceSubnet: "{{ service_cidr }}"
  dnsDomain: "{{ cluster_dns_domain }}"
apiServer:
  extraArgs:
{% for k, v in apiserver_extra_args.items() %}
    {{ k }}: "{{ v }}"
{% endfor %}
controllerManager:
  extraArgs:
{% for k, v in controller_manager_extra_args.items() %}
    {{ k }}: "{{ v }}"
{% endfor %}
scheduler:
  extraArgs:
{% for k, v in scheduler_extra_args.items() %}
    {{ k }}: "{{ v }}"
{% endfor %}
---
apiVersion: kubeadm.k8s.io/v1beta3
kind: InitConfiguration
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
