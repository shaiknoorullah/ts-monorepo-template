---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import Footer from '../components/Footer.astro'
import { jsonLdOrganization } from '../lib/jsonld'

const org = jsonLdOrganization({
  name: 'Example',
  url: 'https://www.example.com',
  logo: 'https://www.example.com/logo.png',
})
---

<Layout
  title="Example — the simplest way to ship multi-tenant SaaS"
  description="Multi-tenant by default. Open-source by design. Free-tier friendly."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
  </Fragment>

  <Hero
    title="From zero to deployed in 3 commands"
    subtitle="Pick a profile. Run npx create-platform@latest, task launch, task open. You get a polyglot monorepo, a Kubernetes cluster sized to your budget, signed images, observability, secrets, and an Argo CD reconcile loop."
    primaryCta={{ label: 'Quickstart', href: '/quickstart' }}
    secondaryCta={{ label: 'Pick a profile', href: '/pricing' }}
  />

  <section data-testid="hero-foot">
    <p>
      <a href="/architecture">How it works</a> · <a href="/troubleshoot">Troubleshoot</a> ·
      <a href="/glossary">Glossary</a>
    </p>
  </section>

  <FeatureGrid
    features={[
      {
        title: 'TypeScript end-to-end',
        body: 'Strict-mode TS across apps, packages, and infra. One language, no glue.',
      },
      {
        title: 'Multi-tenant by default',
        body: 'Schema-per-tenant Postgres + tenant-aware everything. Onboard a tenant in one CLI call.',
      },
      {
        title: 'Edge-deployed',
        body: 'Cloudflare Pages + Workers. No Vercel, no surprise bills.',
      },
      {
        title: 'Mobile + web from one codebase',
        body: 'Expo + react-native-web means the same UI on iOS, Android, and the browser.',
      },
    ]}
  />

  <Footer />
</Layout>
