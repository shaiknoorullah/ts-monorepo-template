{
  "name": "@app/web-app",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant SaaS — Expo + expo-router + react-native-web. Deploys to Cloudflare Pages.",
  "license": "MIT",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web --port 8081",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "expo export --platform web",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@pkg/api-client": "workspace:*",
    "@pkg/auth-client": "workspace:*",
    "@pkg/forms": "workspace:*",
    "@pkg/tenancy-client": "workspace:*",
    "@pkg/tracking": "workspace:*",
    "@pkg/ui": "workspace:*",
    "expo": "~53.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^18.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
