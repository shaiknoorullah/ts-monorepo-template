# pnpm configuration — kept template-permissive on first install.
#
# Why permissive defaults for the template:
#   - Expo SDK + React Native + Tamagui peer-dep declarations are notoriously
#     inconsistent across releases. strict-peer-dependencies=false here lets
#     `pnpm install` succeed on a fresh template clone while still warning.
#   - engine-strict=false is the practical default because Node 22 minor
#     bumps (22.11→22.13→22.x) churn faster than transitive dep engine
#     constraints get republished.
#
# Apps that adopt this template should tighten these (=true) once their
# dependency graph is stable.
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
prefer-workspace-packages=true
link-workspace-packages=deep
save-exact=false
save-workspace-protocol=rolling
engine-strict=false
node-linker=hoisted
