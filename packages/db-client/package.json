{
  "name": "@pkg/db-client",
  "version": "0.0.0",
  "description": "Postgres client wrapper (drizzle-orm) with connection-pool lifecycle helpers.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "attw": "attw --pack . --profile esm-only",
    "build": "tsdown",
    "publint": "publint",
    "test": "vitest run",
    "type-check": "tsc -b"
  },
  "dependencies": {
    "@pkg/types": "workspace:*",
    "drizzle-orm": "catalog:runtime"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "typeCoverage": {
    "atLeast": 95,
    "strict": true,
    "detail": true,
    "ignoreCatch": true
  }
}
